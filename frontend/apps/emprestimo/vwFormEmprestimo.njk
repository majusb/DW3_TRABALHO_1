{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de Emprestimos</h1>
    <p class="text-secondary mb-0">Informações:</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados do emprestimo</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um emprestimo.</p>
        </div>
      </div>

      <form id="frmLivros" data-servidor-trabalho="{{ servidorTrabalho }}">
        <input type="hidden" id="emprestimoId" name="emprestimoId" value="0">
        <input type="hidden" id="deleted" name="deleted" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="nomePessoa" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nomePessoa" name="nomePessoa" maxlength="150" value="" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="endereco" class="form-label">Endereço</label>
            <input type="text" class="form-control" id="endereco" name="endereco" maxlength="150" value="" required>
          </div>

         <div class="col-12 col-md-4">
            <label for="data_emprestimo" class="form-label">Data Emprestimo</label>
            <input type="date" class="form-control" id="data_emprestimo" name="data_emprestimo" value="" required>
        </div>

         <div class="col-12 col-md-4">
            <label for="data_devolucao" class="form-label">Data Devolução</label>
            <input type="date" class="form-control" id="data_devolucao" name="data_devolucao" value="" required>
          </div>


          <div class="col-12 col-md-3">
            <label for="livroId" class="form-label">Livro</label>
            <select class="form-select" id="livroId" name="livroId" required>
              <option value="">Selecione um livro</option
            </select>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirEmprestimo">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarEmprestimo">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverEmprestimo">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/emprestimo" id="btnFecharEmprestimo">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="/apps/livros/vwFormEmprestimo.js"></script>
{% endblock %}
