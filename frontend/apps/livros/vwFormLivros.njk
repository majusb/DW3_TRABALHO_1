{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Tela de CADASTRO de livros. Serve os 4 modos: Cr, Re, Up e De -->
  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de livros</h1>
    <p class="text-secondary mb-0">Manipule os dados cadastrais dos livros.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados do livro</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um livro.</p>
        </div>
      </div>

      <!-- O livroid e o deleted vao escondidos, o usuario nao mexe neles -->
      <form id="frmLivros" data-servidor-trabalho="{{ servidorTrabalho }}">
        <input type="hidden" id="livroid" name="livroid" value="0">
        <input type="hidden" id="deleted" name="deleted" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="nomelivro" class="form-label">Nome do livro</label>
            <input type="text" class="form-control" id="nomelivro" name="nomelivro" maxlength="150" value="" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="autor" class="form-label">Autor</label>
            <input type="text" class="form-control" id="autor" name="autor" maxlength="150" value="" required>
          </div>

          <div class="col-12 col-md-5">
            <label for="genero" class="form-label">Genero</label>
            <input type="text" class="form-control" id="genero" name="genero" maxlength="150" value="" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="valor" class="form-label">Valor em R$</label>
            <input type="number" class="form-control" id="valor" name="valor" step="0.01" min="0" value="" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="status" class="form-label">Disponivel</label>
            <select class="form-select" id="status" name="status" required>
              <option value="true">Sim</option>
              <option value="false">Nao</option>
            </select>
          </div>
        </div>

        <!-- Os 3 primeiros botoes nascem com d-none: o script mostra so o do modo -->
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirLivro">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarLivro">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverLivro">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/livro" id="btnFecharLivro">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="/apps/livros/vwFormLivros.js"></script>
{% endblock %}
